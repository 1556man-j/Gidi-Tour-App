# Same values the website uses (see Gidi-Tour/.env)
EXPO_PUBLIC_SANITY_PROJECT_ID=
EXPO_PUBLIC_SANITY_DATASET=production
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Where the SvelteKit site is hosted (no trailing slash)
EXPO_PUBLIC_API_URL=https://www.giditour.com

# Google sign-in (optional). Web client ID = the GOOGLE_CLIENT_ID the website already uses.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Set to 1 to run the whole app on built-in sample data (no backend needed) for demos
EXPO_PUBLIC_MOCK=0
